# Shared Paikari.shop Supabase project
VITE_SUPABASE_URL=https://mcapstuvnfyyymievjae.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-paikari-publishable-or-anon-key

# Vercel server-side only; never expose this in VITE_* variables
SUPABASE_SERVICE_ROLE_KEY=replace-with-paikari-service-role-key

# Admin/session configuration
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_SITE_ORIGIN=https://origen-prime.vercel.app

# Shared catalog mode: Origen writes directly to Paikari catalog_products
PAIKARI_SHARED_CATALOG=true

# Optional catalog sync to Paikari Edge Function (only for separate projects)
PAIKARI_SYNC_URL=https://mcapstuvnfyyymievjae.supabase.co/functions/v1/sync-origen-catalog
PAIKARI_SYNC_SECRET=replace-with-a-strong-shared-secret

# Optional project wake/restore integration; set to Paikari only if the provider is enabled
FULLSTACK_PROJECT_REF=mcapstuvnfyyymievjae
FULLSTACK_RESTORE_API_URL=
